# Kopieren nach .env und ausfüllen:  cp .env.example .env

# Adresse, unter der der Hub erreichbar sein soll (DNS-Eintrag muss auf den Server zeigen)
DOMAIN=hub.example.de

# E-Mail für das Let's-Encrypt-Zertifikat (Hinweise bei Ablauf o. Ä.)
ACME_EMAIL=info@example.de

# Erster Admin-Zugang (wird nur angelegt, solange es noch keinen Benutzer gibt)
TMH_ADMIN_USER=silas
TMH_ADMIN_PASSWORD=bitte-ein-langes-passwort-eintragen

# Auf 1 setzen, um das Passwort von TMH_ADMIN_USER beim nächsten Start zurückzusetzen
# (danach wieder auf 0 stellen)
TMH_RESET_PASSWORD=0

# Wie viele tägliche Sicherungen aufbewahrt werden
TMH_BACKUP_KEEP=14
