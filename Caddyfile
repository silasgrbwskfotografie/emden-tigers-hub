{
	email {$ACME_EMAIL}
	default_sni {$DOMAIN}
}

{$DOMAIN} {
	encode gzip

	# Uploads und Backups, Umzugsdatei bis 2 GB (die Grenzen pro Anfrage prüft der Hub selbst)
	request_body {
		max_size 2GB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	reverse_proxy hub:8765
}
